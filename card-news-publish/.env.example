# card-news-publish — config template.
# Copy to `.env` in this folder (gitignored) and fill in. Keys are re-read on every publish.

# ── Slack (Socket Mode bot) ─────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Home channel (polled for triggers) and comma-separated approver user IDs
SLACK_CHANNEL=C0123456789
SLACK_ALLOWED_USERS=U0123456789

# ── Instagram (professional account, Instagram Login) ──
# Meta app → Instagram → "API setup with Instagram login" → connect account → generate token
# Permissions: instagram_business_basic, instagram_business_content_publish (long-lived, 60 days)
IG_USER_ID=
IG_ACCESS_TOKEN=

# ── Threads ─────────────────────────────────────────
# Meta app → Threads use case → invite the account as a Threads tester → generate token
# Permissions: threads_basic, threads_content_publish (long-lived, 60 days)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ── Supabase Storage (public bucket, uploaded only at publish time) ──
# Project Settings → Data API (Project URL) / API Keys (secret key, or legacy service_role)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=card-news

# ── Options ─────────────────────────────────────────
# 1 = run the whole approval flow but skip posting
PUBLISH_DRY_RUN=0
