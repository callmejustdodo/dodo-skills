{
  "name": "korean-tax-invoice",
  "version": "0.1.0",
  "description": "한국 전자세금계산서 발행 — 중복 발행과 잘못된 발행을 구조로 막는다",
  "type": "module",
  "license": "MIT",
  "author": "Seonggu Kim (sdkfile)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdkfile/korean-tax-invoice.git"
  },
  "keywords": [
    "korea",
    "tax-invoice",
    "세금계산서",
    "전자세금계산서",
    "bolta",
    "볼타",
    "claude-code",
    "skill"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SKILL.md",
    "references",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
